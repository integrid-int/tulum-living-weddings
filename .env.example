# Public site metadata
NEXT_PUBLIC_SITE_URL=https://www.tulumlivingweddings.com

# Sanity client configuration (read)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Sanity server-side write token (contact submissions)
SANITY_API_WRITE_TOKEN=your_sanity_write_token

# Shared secret for /api/revalidate webhook authentication
SANITY_REVALIDATE_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Studio access protection (required in production)
STUDIO_BASIC_AUTH_USER=studio_admin
STUDIO_BASIC_AUTH_PASSWORD=replace_with_strong_password

# Contact notification settings
CONTACT_NOTIFICATION_TO=hello@tulumlivingweddings.com
CONTACT_FROM_EMAIL=no-reply@tulumlivingweddings.com
CONTACT_EMAIL_WEBHOOK_URL=https://your-email-provider-webhook.example.com/send
CONTACT_EMAIL_WEBHOOK_TOKEN=replace_with_provider_token

# Optional: Google Places API (used by scripts/import-google-business.mjs)
GOOGLE_PLACES_API_KEY=your_google_places_api_key
